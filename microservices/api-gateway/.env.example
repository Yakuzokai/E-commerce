# Environment Configuration
NODE_ENV=development
PORT=3000

# Security
JWT_SECRET=your-super-secret-jwt-key-change-in-production
CORS_ORIGIN=*

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=200

# Downstream Microservice Routing URLs
AUTH_SERVICE_URL=http://localhost:3001
USER_SERVICE_URL=http://localhost:3008
PRODUCT_SERVICE_URL=http://localhost:3003
CART_SERVICE_URL=http://localhost:3006
ORDER_SERVICE_URL=http://localhost:3004
PAYMENT_SERVICE_URL=http://localhost:3015
SEARCH_SERVICE_URL=http://localhost:3005
REVIEW_SERVICE_URL=http://localhost:3009
RECOMMENDATION_SERVICE_URL=http://localhost:3010
NOTIFICATION_SERVICE_URL=http://localhost:3007
ANALYTICS_SERVICE_URL=http://localhost:3014
CHAT_SERVICE_URL=http://localhost:3011

# Logging
LOG_LEVEL=info
