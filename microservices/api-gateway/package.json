{
  "name": "@shophub/api-gateway",
  "version": "1.0.0",
  "description": "API Gateway and Ingress Controller for ShopHub E-Commerce Platform",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
